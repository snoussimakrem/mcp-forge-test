# Free OpenRouter AI
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Optional GitHub token
# Needed later only for private repositories or higher GitHub API limits.
GITHUB_TOKEN=

# Leave blank in Colab to use temporary in-memory Qdrant.
# Use http://qdrant:6333 when running Docker Compose.
QDRANT_URL=
QDRANT_COLLECTION=mcp_forge_memory

# Safety: keep false until a future approval-gated write workflow exists.
ALLOW_GITHUB_WRITES=false
